{
  "name": "ta-website-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.mjs",
    "build": "node src/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "package:site": "node scripts/package-site.mjs",
    "backup:create": "node scripts/site-snapshot.mjs create",
    "backup:restore": "node scripts/site-snapshot.mjs restore",
    "release:check": "node scripts/release-check.mjs",
    "release:visual": "node scripts/release-screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
